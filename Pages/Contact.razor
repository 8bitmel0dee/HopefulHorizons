@page "/contact"

<div class="card hero-card mx-auto mb-4" style="max-width: 700px; background-color: #FFF5EE; border: none;">
    <div class="card-body">

        <h2 class="text-center" style="color: var(--river-bed); margin-bottom: 40px;">
            Contact Us
        </h2>

        <p class="about-text" style="text-align:center">
            Reaching out for support is a brave and meaningful step.<br /><br />
            Whether you're ready to begin therapy or simply have questions,<br />
            we're here to help you find the clarity and care you deserve.
        </p>

        <div class="contact-section" style="background-color: #fceee3; border-left: 5px solid var(--river-bed); padding: 15px; border-radius: 6px; margin-top: 40px;">
            <h4 style="margin-top: 0; color: var(--river-bed);">Office Location</h4>
            <p style="margin: 0; line-height: 1.6;">
                Hopeful Horizons Therapeutics, LLC<br />
                1409 Blackburn Ave<br />
                Ashland, KY 41101
            </p>
        </div>


        <!-- Google Map section-->


        <div class="contact-section" style="margin-top: 40px;">
            <h4 style="color: var(--river-bed);">Find Us</h4>




            <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 6px;">

                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3124.00531180394!2d-82.6607569226677!3d38.464438671819764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8846767d5b0765e7%3A0x22de6e1db4da37b8!2s1409%20Blackburn%20Ave%2C%20Ashland%2C%20KY%2041101!5e0!3m2!1sen!2sus!4v1768446506937!5m2!1sen!2sus"
                        width="600" height="450"
                        style="border:0; border-radius: 6px;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>


        </div>

        <div class="contact-section" style="background-color: #fdf4ef; border-left: 5px solid var(--river-bed); padding: 15px; border-radius: 6px; margin-top: 40px;">
            <h4 style="margin-top: 0; color: var(--river-bed);">Phone</h4>
            <p style="margin: 0; line-height: 1.6;">
                <!-- Replace with number -->
                <em>Phone number coming soon</em>
            </p>
        </div>

        <div class="contact-section" style="background-color: #fdf4ef; border-left: 5px solid var(--river-bed); padding: 15px; border-radius: 6px; margin-top: 40px;">
            <h4 style="margin-top: 0; color: var(--river-bed);">Email</h4>
            <p style="margin: 0; line-height: 1.6;">
                <!-- Replace this tomorrow -->
                <em>Email coming soon</em>
            </p>
        </div>


        <p class="about-quote" style="margin-top: 25px;">
            You deserve support that meets you where you are.
            <br />
            <br />
            When you're ready, we're here.
        </p>

    </div>
</div>


@page "/"



<div class="hero-section section-padding">

    <!-- Logo -->

    <img src="images/logo.png" alt="Hopeful Horizons Therapeutics logo" class="hero-logo" />

    <!-- Home intro card -->
    <h2 class="hero-subheading">Healing Begins with Hope</h2>
    <div class="card hero-card mx-auto mb-4" style="max-width: 700px; background-color: #FFF5EE; border: none;">

        <div class="card-body">
            
            <p class="card-text">At Hopeful Horizons, we believe in your capacity to grow, heal, and reclaim your life.</p>
            
            <p class="card-text">Whether you're navigating anxiety, trauma, addiction, grief, or life transitions,</p>
            <p class="card-text">you're not alone.</p>

            <p class="card-text">We provide compassionate, evidence-based therapy tailored to your unique journey because you deserve support that sees the whole you.</p>
            
            <p class="card-text">Let's take the next step - together.</p>

        </div>
    </div>


    <!-- About Us Button -->

    <div class="hero-cta" >
        <a href="/about" class="btn btn-primary">

            🡺 Learn More About Us</a>
        
    </div>

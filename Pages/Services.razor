@page "/services"


<div class="card hero-card mx-auto mb-4" style="max-width: 700px; background-color: #FFF5EE; border: none;">

    <div class="card-body">

        <!-- Services Header-->

        <div class="card-intro info-block" style="margin-bottom: 20px;">
            
            <p style="margin: 0; font-size: 1.1em; line-height: 1.6; color: var(--river-bed);
;">

            At  <strong> Hopeful Horizons Therapeutics, LLC</strong>, 
            we believe that financial challenges should not prevent
            access to quality mental health care. 
            
            <br />
            <br />
          
            We offer a sliding fee scale based on household income.

            </p>
        </div>

        <!-- Income Scale -->

        <table class="fee-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th>Annual Household Income</th>
                    <th>Diagnostic Assessment</th>
                    <th>Therapy Session</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>$25,000 - $34,999</td><td>$90</td><td>$65</td></tr>
                <tr><td>$35,000 - $44,999</td><td>$108</td><td>$78</td></tr>
                <tr><td>$45,000 - $54,999</td><td>$126</td><td>$90</td></tr>
                <tr><td>$55,000 - $64,999</td><td>$144</td><td>$100</td></tr>
                <tr><td>$65,000 - $74,999</td><td>$162</td><td>$110</td></tr>
                <tr><td>$75,000+</td><td>$180 (Full Rate)</td><td>$125 (Full Rate)</td></tr>
            </tbody>
        </table>

        <!-- Proof of Income line -->

        <p style="margin-top: 15px; font-size: 0.95em; text-align: center; color: var(--river-bed); margin-bottom: 20px;">

            <em>Proof of income required</em> 
            <br/>
            ( for example: a recent tax return, W‑2, or two current pay stubs )
        
        </p>

        <!-- Payment Policy -->

        <div class="payment-policy info-block" style="margin-top: 30px; margin-bottom: 20px;">
            
            <h4 style="margin-top: 0; color: var(--river-bed);">
                Payment Policy
            </h4>
            
            <ul class="clean-list" style="margin-bottom: 10px;">
                
                <li>Clients may arrange payment plans if unable to pay the full amount at the time of service.</li>
            
                <li>No client may carry a balance exceeding <strong>$300</strong>.</li>
                
                <li>If a balance of $300 is reached, services may be paused until a payment is made.</li>
                
                <li>Payments can be made via cash, check, or card.</li>
            </ul>
            
            <br />
            
     
         </div>

        <!-- Accepted Insurance -->

        <div class="contact-section info-block" style="margin-top: 30px; margin-bottom: 20px;">
            
            <h4 style="margin-top: 0; color: var(--river-bed);">
                Accepted Insurance</h4>
            
            <ul class="clean-list">
                <li>Aetna</li>

                <li>Anthem</li>

                <li>BlueCross and BlueShield</li>

                <li>Carelon Behavioral Health</li>

                <li>Humana</li>

                <li>Medicaid</li>

                <li>UnitedHealthcare (UHC | UBH)</li>

                <li>WellCare</li>
            </ul>
        </div>

        <!-- Contact Us Button -->

        <div class="hero-cta" style="text-align: center;">
            <a href="/contact" class="btn btn-primary">
                
                🡺 Contact Us</a>

        </div>

        <!-- End of Section -->

        <p style="font-style: italic; color: var(--river-bed); margin-top: 10px; text-align: center;">

            Thank you for allowing us to be part of your healing journey.<br><br />

            We are honored to walk alongside you toward hope and healing.
        </p>

    </div>
</div>






